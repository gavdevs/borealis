# Private one-time owner-setup credential, not an everyday login password.
# Also salts rate-limit keys and derives Better Auth's cookie-signing secret
# using domain-separated HMAC. No additional auth secret is required.
# Keep stable: rotation invalidates browser cookies, not passwords or phone keys.
# Never put it in browser storage.
BOREALIS_ADMIN_TOKEN=replace-with-at-least-24-random-characters

# Keep this database on persistent storage. It contains password hashes, opaque
# Better Auth session tokens (not digests), device-credential digests, accounts,
# the allowlist, jobs, and the Borealis signing key. Keep backups private.
BOREALIS_DATABASE_PATH=./data/borealis.sqlite

# Optional hosted libSQL database on Turso. Set BOTH to enable remote storage.
# Leave both unset to keep using the local SQLite path above.
# Never expose the database token to the browser or commit a real token.
# TURSO_DATABASE_URL=libsql://your-borealis-database.turso.io
# TURSO_AUTH_TOKEN=your-database-scoped-token

# Public origin shown to a phone during pairing.
BOREALIS_PUBLIC_BASE_URL=http://localhost:8787

BOREALIS_PORT=8787
BOREALIS_HOST=127.0.0.1
BOREALIS_PAIRING_TTL_MINUTES=10
BOREALIS_JOB_TTL_SECONDS=900
BOREALIS_PLAY_LANGUAGE=en
BOREALIS_PLAY_COUNTRY=us

# Optional user-report filing. Set BOTH to let signed-in people and paired
# phones file GitHub issues through the server. Set neither to disable reports;
# the web form then explains that filing is unavailable. Use a fine-grained
# token limited to this one repository with Issues: read and write and nothing
# else. The token stays server-side: never commit it or expose it to a browser.
# BOREALIS_GITHUB_REPORT_REPOSITORY=gavdevs/borealis
# BOREALIS_GITHUB_REPORT_TOKEN=github_pat_replace_with_a_repository_scoped_token
