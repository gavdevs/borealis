{
  "name": "@borealis/companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "pnpm typecheck && pnpm build:web && tsc -p tsconfig.server.build.json",
    "build:web": "vite build",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "worker:types": "wrangler types",
    "worker:types:check": "wrangler types --check",
    "worker:typecheck": "tsc -p tsconfig.worker.json --noEmit",
    "worker:dry-run": "wrangler deploy --dry-run --outdir dist/worker",
    "worker:check": "pnpm worker:types:check && pnpm worker:typecheck && pnpm worker:dry-run",
    "worker:dev": "pnpm build:web && wrangler dev",
    "worker:migrate": "tsx scripts/migrate.ts",
    "worker:deploy": "pnpm build:web && wrangler deploy",
    "worker:release": "pnpm worker:migrate && pnpm worker:deploy"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@hono/node-server": "1.19.9",
    "@libsql/client": "0.18.0",
    "hono": "4.13.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260926.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.141.0"
  }
}
